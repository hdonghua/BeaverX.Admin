{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=beaverx-admin;Username=postgres;Password=postgres;Pooling=true;MinPoolSize=5;MaxPoolSize=100;Timeout=30;CommandTimeout=120;"
  },
  "CorsOrgins": "http://localhost:5173,http://127.0.0.1:5173",
  "Jwt": {
    "Issuer": "BeaverX.Admin",
    "Audience": "BeaverX.Admin",
    "SecretKey": "BeaverX.Admin.Development.SecretKey.Must.Be.At.Least.32.Chars",
    "ExpiresInMinutes": 30,
    "RefreshTokenExpiresInDays": 1
  },
  "Cache": {
    "KeyPrefix": "beaverx:admin:",
    "RedisConnectionString": "localhost:6379",
    "DefaultExpirationSeconds": 3600
  },
  "Payment": {
    "BaseNotifyUrl": "http://localhost:5216",
    "DefaultExpireMinutes": 30,
    "CertCacheRootPath": "payment-certs"
  },
  "Minio": {
    "Endpoint": "http://127.0.0.1:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "beaverx-admin",
    "UseSsl": false,
    "MaxFileSizeMb": 10,
    "PresignedUrlExpirySeconds": 604800
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "SyncBusinessJobsOnStartup": true,
    "BusinessJobStartupSyncMode": "MergeFromHangfire",
    "Auth": {
      "Enabled": true,
      "Username": "hangfire",
      "Password": "hangfire123"
    }
  }
}
